# Mobile-side env vars (must be prefixed with EXPO_PUBLIC_ to be embedded in the bundle)
#
# Web / iOS simulator: localhost works
# Android emulator (AVD): use 10.0.2.2 to reach host's localhost
# Real device on same Wi-Fi: use the dev machine's LAN IP, e.g. http://192.168.1.10:3000
#
# Leaving this unset uses the platform-aware default in src/config.ts.
EXPO_PUBLIC_API_URL=http://localhost:3000
