PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookkeeping
DB_PASSWORD=bookkeeping
DB_NAME=bookkeeping

# 开发期可以 true，生产环境务必 false 并改用迁移
DB_SYNCHRONIZE=true

# 用 openssl rand -hex 32 生成
JWT_ACCESS_SECRET=replace-me-with-random-32-bytes-hex
JWT_REFRESH_SECRET=replace-me-with-different-random-32-bytes-hex

# 单位：秒
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# CORS：留空 = 允许所有；多个用逗号分隔
CORS_ORIGINS=
